# Apache 2.4+ vHost example for LexNova.
# Only httpdocs/ is public. Keep the project root outside DocumentRoot.
<VirtualHost *:80>
    ServerName legal.example.com
    DocumentRoot /var/www/lexnova/httpdocs

    <Directory /var/www/lexnova/httpdocs>
        Options -Indexes +FollowSymLinks
        AllowOverride None
        Require all granted
        FallbackResource /index.php
    </Directory>
</VirtualHost>

# Configure TLS separately (for example through your hosting panel or Certbot).
# Passkeys require the public HTTPS origin to match [app].base_url exactly.
# Logging intentionally uses the host's global Apache configuration.
