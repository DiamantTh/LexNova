# Block access to dotfiles
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Serve existing static files/directories directly. /out.php intentionally
    # does not exist and is therefore handled by index.php below.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Route everything else through the Mezzio front controller
    RewriteRule ^ index.php [QSA,L]
</IfModule>
