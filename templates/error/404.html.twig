{% extends 'error/layout.html.twig' %}

{% block title %}404 · Seite nicht gefunden · LexNova{% endblock %}
{% block error_code %}404{% endblock %}
{% block error_heading %}Hier gibt es nichts zu finden.{% endblock %}

{% block error_message %}
    Die angeforderte Seite existiert nicht, wurde verschoben oder der verwendete
    Dokument-Link ist nicht mehr gültig.
{% endblock %}

{% block error_request %}
    {% if request is defined %}
        <p class="error-request">{{ request.uri.path }}</p>
    {% endif %}
{% endblock %}

{% block error_actions %}
    <a class="error-action" href="/admin">Zu LexNova</a>
{% endblock %}
