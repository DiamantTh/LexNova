{% extends 'error/layout.html.twig' %}

{% block title %}500 · Serverfehler · LexNova{% endblock %}
{% block error_code %}500{% endblock %}
{% block error_heading %}LexNova konnte die Anfrage nicht abschließen.{% endblock %}

{% block error_message %}
    Es ist ein unerwarteter Fehler aufgetreten. Versuche es erneut oder wende
    dich an die Administration, falls der Fehler bestehen bleibt.
{% endblock %}

{% block error_actions %}
    <a class="error-action" href="/admin">Zu LexNova</a>
    <a class="error-action secondary" href="">Erneut versuchen</a>
{% endblock %}
