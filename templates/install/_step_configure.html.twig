<div class="card" style="max-width:640px;margin:0 auto;">
    <form method="post" action="/install">
        <input type="hidden" name="__csrf" value="{{ csrf_token }}">
        <input type="hidden" name="action" value="install">

        {# ── Install-Passwort (muss bei jedem Absenden mitgesendet werden) ── #}
        <h2>Install-Passwort</h2>
        <div style="margin-bottom:16px;">
            <label for="install_pw">Passwort</label>
            <input type="password" id="install_pw" name="install_pw" required autocomplete="off">
        </div>

        <hr class="section-sep">
        <h2>Datenbank</h2>
        <div class="grid" style="margin-bottom:14px;">
            <div>
                <label for="app_base_url">
                    Öffentliche Basis-URL
                    <small>(HTTPS erforderlich; nur lokal ist <code>http://localhost</code> erlaubt)</small>
                </label>
                <input type="url" id="app_base_url" name="app_base_url"
                       value="{{ formData.appBaseUrl ?? '' }}" required
                       placeholder="https://legal.example.com" autocomplete="url">
            </div>
            <div>
                <label for="db_type">Typ</label>
                <select id="db_type" name="db_type">
                    <option value="sqlite"{{ formData.dbType == 'sqlite' ? ' selected' : '' }}>SQLite</option>
                    <option value="mysql"{{ formData.dbType == 'mysql' ? ' selected' : '' }}>MySQL/MariaDB</option>
                    <option value="pgsql"{{ formData.dbType == 'pgsql' ? ' selected' : '' }}>PostgreSQL</option>
                </select>
            </div>
            <div id="sqlite-fields">
                <label for="db_path">SQLite-Dateipfad</label>
                <input type="text" id="db_path" name="db_path" value="{{ formData.dbPath ?? '' }}" placeholder="/absoluter/pfad/zur/db.sqlite">
            </div>
            <div id="server-fields" style="display:none;">
                <label for="db_host">Host</label>
                <input type="text" id="db_host" name="db_host" value="{{ formData.dbHost ?? 'localhost' }}">
            </div>
            <div id="server-name" style="display:none;">
                <label for="db_name">Datenbankname</label>
                <input type="text" id="db_name" name="db_name" value="{{ formData.dbName ?? '' }}">
            </div>
            <div id="server-port" style="display:none;">
                <label for="db_port">Port (optional)</label>
                <input type="text" id="db_port" name="db_port" value="{{ formData.dbPort ?? '' }}">
            </div>
            <div id="server-user" style="display:none;">
                <label for="db_user">Benutzername</label>
                <input type="text" id="db_user" name="db_user" value="{{ formData.dbUser ?? '' }}" autocomplete="off">
            </div>
            <div id="server-pass" style="display:none;">
                <label for="db_password">Passwort</label>
                <input type="password" id="db_password" name="db_password" autocomplete="new-password">
            </div>
        </div>

        <hr class="section-sep">
        <h2>Admin-Konto</h2>
        <div class="grid" style="margin-bottom:14px;">
            <div>
                <label for="admin_username">Benutzername</label>
                <input type="text" id="admin_username" name="admin_username" value="{{ formData.adminUsername ?? '' }}" required autocomplete="off">
            </div>
            <div>
                <label for="admin_password">Passwort</label>
                <input type="password" id="admin_password" name="admin_password" required autocomplete="new-password">
            </div>
            <div>
                <label for="admin_password_confirm">Passwort bestätigen</label>
                <input type="password" id="admin_password_confirm" name="admin_password_confirm" required autocomplete="new-password">
            </div>
        </div>

        <hr class="section-sep">
        <h2>Anwendung</h2>
        <div class="grid" style="margin-bottom:14px;">
            <div>
                <label for="app_locale">
                    Standard-Sprache
                    <small>(BCP 47, z.&nbsp;B. <code>de</code>, <code>en-US</code>, <code>fr-CH</code>)</small>
                </label>
                <input type="text" id="app_locale" name="app_locale"
                       value="{{ formData.appLocale ?? 'de' }}"
                       required placeholder="de"
                       pattern="[a-zA-Z]{2,8}(-[a-zA-Z0-9]{1,8})*"
                       title="BCP 47 Sprachtag, z. B. de, en-US, zh-Hant">
            </div>
        </div>

        <hr class="section-sep">
        <h2>Anwendungs-Cache</h2>
        <p style="color:#4a4a4a;font-size:14px;margin-bottom:14px;">
            Der Cache enthält ausschließlich ersetzbare Kopien; die Datenbank bleibt maßgeblich.
            APCu ist für einen klassischen einzelnen PHP-Webspace empfohlen, sofern es im hier
            verwendeten Web-SAPI verfügbar ist. Dateisystem funktioniert ohne Zusatzdienst.
        </p>
        <div class="grid" style="margin-bottom:14px;">
            <div>
                <label for="cache_adapter">Adapter</label>
                <select id="cache_adapter" name="cache_adapter">
                    <option value="filesystem"{{ (formData.cacheAdapter ?? 'filesystem') == 'filesystem' ? ' selected' : '' }}>
                        Dateisystem · universeller Standard
                    </option>
                    <option value="apcu"
                        {{ (formData.cacheAdapter ?? '') == 'apcu' ? ' selected' : '' }}
                        {{ not cacheSupport.apcu.available ? ' disabled' : '' }}>
                        APCu · schneller lokaler Webcache{{ not cacheSupport.apcu.available ? ' (nicht verfügbar)' : '' }}
                    </option>
                    <option value="valkey"
                        {{ (formData.cacheAdapter ?? '') == 'valkey' ? ' selected' : '' }}
                        {{ not cacheSupport.valkey.available ? ' disabled' : '' }}>
                        Valkey · externer zentraler Cache{{ not cacheSupport.valkey.available ? ' (Client fehlt)' : '' }}
                    </option>
                </select>
                <small id="cache-adapter-status" style="color:#666;display:block;margin-top:5px;">
                    APCu: {{ cacheSupport.apcu.reason }} Valkey: {{ cacheSupport.valkey.reason }}
                </small>
            </div>
        </div>
        <div id="valkey-fields" class="grid" style="margin-bottom:14px;display:none;">
            <div>
                <label for="cache_host">Valkey-Host</label>
                <input type="text" id="cache_host" name="cache_host" value="{{ formData.cacheHost ?? '127.0.0.1' }}">
            </div>
            <div>
                <label for="cache_port">Port</label>
                <input type="number" id="cache_port" name="cache_port" min="1" max="65535" value="{{ formData.cachePort ?? '6379' }}">
            </div>
            <div>
                <label for="cache_database">Logische Datenbank</label>
                <input type="number" id="cache_database" name="cache_database" min="0" value="{{ formData.cacheDatabase ?? '0' }}">
            </div>
            <div>
                <label for="cache_username">ACL-Benutzername (optional)</label>
                <input type="text" id="cache_username" name="cache_username" value="{{ formData.cacheUsername ?? '' }}" autocomplete="off">
            </div>
            <div>
                <label for="cache_password">Passwort (optional)</label>
                <input type="password" id="cache_password" name="cache_password" autocomplete="new-password">
            </div>
            <div>
                <label for="cache_tls">
                    <input type="checkbox" id="cache_tls" name="cache_tls" value="1"{{ (formData.cacheTls ?? '0') == '1' ? ' checked' : '' }}>
                    TLS verwenden
                </label>
            </div>
        </div>

        <hr class="section-sep">
        <h2>Betreiber dieser LexNova-Instanz</h2>
        <p style="color:#4a4a4a;font-size:14px;margin-bottom:14px;">
            LexNova stellt öffentlich erreichbare Impressums- und Datenschutzseiten bereit.
            Als Betreiber dieser Instanz bist du selbst impressumspflichtig.
            Gib hier den Namen und die Kontaktdaten ein — eine Rechtsentität wird direkt angelegt
            und die URLs können nach der Installation sofort befüllt und verlinkt werden.
        </p>
        <div class="grid" style="margin-bottom:14px;">
            <div>
                <label for="operator_name">Name / Organisation <span aria-hidden="true" style="color:#b71c1c;">*</span></label>
                <input type="text" id="operator_name" name="operator_name"
                       value="{{ formData.operatorName ?? '' }}" required
                       placeholder="Max Mustermann / Muster GmbH"
                       autocomplete="organization">
            </div>
            <div>
                <label for="operator_contact">Kontaktdaten <span aria-hidden="true" style="color:#b71c1c;">*</span></label>
                <textarea id="operator_contact" name="operator_contact"
                          required style="min-height:90px;"
                          placeholder="Adresse, E-Mail, Telefon …">{{ formData.operatorContact ?? '' }}</textarea>
                <small style="color:#666;">Freitext — wird auf der Impressumsseite obfuskiert ausgegeben (Schutz vor Spam-Bots).</small>
            </div>
        </div>

        <div class="actions">
            <button type="submit">Installieren</button>
        </div>
    </form>

    <script>
    (function(){
        const sel = document.getElementById('db_type');
        const cacheSel = document.getElementById('cache_adapter');
        if (!sel || !cacheSel) return;

        function toggle() {
            const isSqlite = sel.value === 'sqlite';
            document.getElementById('sqlite-fields').style.display = isSqlite ? '' : 'none';
            ['server-fields','server-name','server-port','server-user','server-pass']
                .forEach(id => { document.getElementById(id).style.display = isSqlite ? 'none' : ''; });
        }

        sel.addEventListener('change', toggle);
        function toggleCache() {
            document.getElementById('valkey-fields').style.display = cacheSel.value === 'valkey' ? '' : 'none';
        }
        cacheSel.addEventListener('change', toggleCache);
        toggle();
        toggleCache();
    })();
    </script>
</div>
