{% extends 'layout.html.twig' %}

{% block title %}{{ trans('Admin Login') }} · LexNova{% endblock %}

{% block body %}
<header>
    <h1>LexNova</h1>
</header>

{% for msg in errors %}
<div class="notice error" role="alert">{{ msg }}</div>
{% endfor %}

<div class="card" style="max-width:420px;margin:0 auto;">
    <h2>{{ trans('Admin Login') }}</h2>
    <p>Passkey oder FIDO2-Sicherheitsschlüssel verwenden – ohne Passwort und ohne übertragbares Geheimnis.</p>
    <button type="button" id="passkey-login" autofocus>Mit Passkey anmelden</button>
    <p id="passkey-status" role="status" style="font-size:14px;margin-bottom:0;"></p>
    <details style="margin-top:22px;">
        <summary>Alternativ mit Passwort anmelden</summary>
        <form method="post" action="/admin/login" style="margin-top:14px;">
            <input type="hidden" name="__csrf" value="{{ csrf_token }}">
            <div style="margin-bottom:14px;">
                <label for="username">{{ trans('Username') }}</label>
                <input type="text" id="username" name="username" autocomplete="username" required maxlength="100">
            </div>
            <div style="margin-bottom:14px;">
                <label for="password">{{ trans('Password') }}</label>
                <input type="password" id="password" name="password" autocomplete="current-password" required maxlength="256">
            </div>
            <div class="actions">
                <button type="submit" class="secondary">{{ trans('Sign in') }}</button>
            </div>
        </form>
    </details>
</div>
<script>
(() => {
    const csrf = {{ csrf_token|json_encode|raw }};
    const b64 = value => Uint8Array.from(atob(value.replace(/-/g, '+').replace(/_/g, '/').padEnd(Math.ceil(value.length / 4) * 4, '=')), c => c.charCodeAt(0));
    const b64url = value => btoa(String.fromCharCode(...new Uint8Array(value))).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
    const post = async (url, data) => {
        const body = new URLSearchParams({__csrf: csrf, ...data});
        const response = await fetch(url, {method: 'POST', headers: {'Content-Type': 'application/x-www-form-urlencoded'}, body, credentials: 'same-origin'});
        return response.json();
    };
    const button = document.getElementById('passkey-login');
    const status = document.getElementById('passkey-status');
    if (!window.PublicKeyCredential || !navigator.credentials) {
        button.disabled = true;
        status.textContent = 'Dieser Browser unterstützt keine Passkeys. Passwort-Anmeldung verwenden.';
        return;
    }
    button.addEventListener('click', async () => {
        button.disabled = true;
        status.textContent = 'Passkey wird angefordert …';
        try {
            const options = await post('/admin/passkeys/login/options', {});
            if (options.error) throw new Error(options.error);
            options.challenge = b64(options.challenge);
            if (options.allowCredentials) options.allowCredentials.forEach(c => c.id = b64(c.id));
            const credential = await navigator.credentials.get({publicKey: options});
            const payload = {id: credential.id, rawId: b64url(credential.rawId), type: credential.type, response: {
                authenticatorData: b64url(credential.response.authenticatorData), clientDataJSON: b64url(credential.response.clientDataJSON),
                signature: b64url(credential.response.signature), userHandle: credential.response.userHandle ? b64url(credential.response.userHandle) : null
            }};
            const result = await post('/admin/passkeys/login/finish', {credential: JSON.stringify(payload)});
            if (result.error) throw new Error(result.error); window.location.assign(result.redirect);
        } catch (error) {
            status.textContent = error.message || 'Passkey-Anmeldung fehlgeschlagen.';
            button.disabled = false;
        }
    });
})();
</script>
{% endblock %}
