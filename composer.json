{
    "name": "lexnova/lexnova",
    "type": "project",
    "description": "LexNova – Legal document management",
    "license": "AGPL-3.0-or-later",
    "require": {
        "ext-ctype": "*",
        "ext-fileinfo": "*",
        "ext-filter": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-redis": "^6.0",
        "ext-sodium": "*",
        "php": ">=8.4.1",
        "bjeavons/zxcvbn-php": "^1.4",
        "devium/toml": "^1.0",
        "doctrine/dbal": "^3.7",
        "endroid/qr-code": "^5.0",
        "laminas/laminas-cache": "^4.3",
        "laminas/laminas-cache-storage-adapter-filesystem": "^3.2",
        "laminas/laminas-cache-storage-adapter-redis": "^3.2",
        "laminas/laminas-diactoros": "^3.3",
        "laminas/laminas-filter": "^3.4",
        "laminas/laminas-i18n": "^3.0@dev",
        "laminas/laminas-inputfilter": "^3.0@dev",
        "laminas/laminas-validator": "^3.18",
        "mezzio/mezzio": "^3.20",
        "mezzio/mezzio-csrf": "^1.3",
        "mezzio/mezzio-fastroute": "^3.11",
        "mezzio/mezzio-session": "^1.10",
        "mezzio/mezzio-session-ext": "^1.6",
        "mezzio/mezzio-twigrenderer": "^2.14",
        "monolog/monolog": "^3.0",
        "paragonie/sodium_compat": "^1.21 || ^2.5",
        "paragonie/sodium_compat_ext_sodium": "^1.0",
        "php-di/php-di": "^7.1",
        "phpdocumentor/reflection-docblock": "^5.6",
        "psr/clock": "^1.0",
        "psr/simple-cache": "^3.0",
        "spomky-labs/otphp": "^11.4",
        "symfony/cache": "^7.4",
        "symfony/console": "^7.0",
        "symfony/polyfill-ctype": "^1.37",
        "symfony/polyfill-iconv": "^1.33",
        "symfony/polyfill-mbstring": "^1.38",
        "symfony/property-info": "^7.4",
        "symfony/serializer": "^7.4",
        "twig/twig": "^3.0",
        "web-auth/webauthn-lib": "^5.2"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.75",
        "laminas/laminas-cache-storage-adapter-memory": "^3.2",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "LexNova\\": "src/"
        }
    },
    "bin": ["bin/lexnova"],
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=512M",
        "cs-check": "php-cs-fixer check --diff",
        "cs-fix": "php-cs-fixer fix",
        "test:config": [
            "@php tests/Config/ConfigExampleTest.php",
            "@php tests/Config/DatabaseConfigurationTest.php",
            "@php tests/Config/CacheBackendIdentificationTest.php",
            "@php tests/Config/PlatformRequirementsTest.php"
        ],
        "test:integration": [
            "@php tests/Integration/DocumentEndpointTest.php",
            "@php tests/Integration/InputFilterTest.php",
            "@php tests/Integration/PasskeyServiceTest.php",
            "@php tests/Integration/TranslationServiceTest.php"
        ],
        "test:security": [
            "@php tests/Security/EmailExtensionTest.php",
            "@php tests/Security/RateLimitServiceTest.php",
            "@php tests/Security/TotpEncryptionTest.php",
            "@php tests/Security/SecurityHeadersMiddlewareTest.php",
            "@php tests/Security/InstallRateLimitServiceTest.php",
            "@php tests/Security/Fail2BanLogServiceTest.php",
            "@php tests/Security/SystemInfoServiceTest.php"
        ],
        "test": ["@test:config", "@test:integration", "@test:security"],
        "qa": ["@analyse", "@cs-check", "@test"]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
